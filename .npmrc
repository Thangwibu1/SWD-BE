# better-sqlite3 ships prebuilt binaries (win32/linux/linuxmusl/darwin) inside
# its tarball, but `npm ci` infers a default `node-gyp rebuild` install script
# from binding.gyp because the lockfile does not record `gypfile: false`.
# That forces a C++ toolchain on every fresh clone. No dependency here needs an
# install script (esbuild resolves its platform binary via optionalDependencies),
# so scripts are disabled to keep fresh clone, CI and Docker builds identical.
ignore-scripts=true
fund=false
audit=false
