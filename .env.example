NODE_ENV=development
APP_ROLE=controller-api
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

EVALUATOR_DB_PATH=./data/evaluator.db
RESULTS_ROOT=./results
ARCHITECTURE_REGISTRY_DIR=./architecture-registry
COST_CATALOG_DIR=./cost-catalogs

DOCKER_BIN=docker
DOCKER_PROJECT_PREFIX=bench
SUT_HOST=127.0.0.1
SUT_PORT_RANGE_START=20000
SUT_PORT_RANGE_END=21000
MAX_CONCURRENT_EXPERIMENTS=1
EXPERIMENT_LEASE_SECONDS=300

LOAD_RUNNER_MODE=local
K6_BIN=k6
LOAD_HOST_SSH=
LOAD_HOST_WORKDIR=/opt/architecture-benchmark

PROMETHEUS_URL=http://127.0.0.1:9090
CADVISOR_URL=http://127.0.0.1:8080

DEFAULT_WARMUP_SECONDS=120
DEFAULT_MEASURE_SECONDS=600
DEFAULT_COOLDOWN_SECONDS=60
DEFAULT_REPETITIONS=5
EVENTUAL_TIMEOUT_MS=5000

# SUT roles (sut-monolith, api-gateway, *-service)
DATABASE_URL=postgres://bench:bench@localhost:25432/ecommerce
REDIS_URL=redis://localhost:6379
ARCHITECTURE_ID=A01
SUT_PORT=3000
DB_POOL_MAX=10
SERVICE_TIMEOUT_MS=5000
