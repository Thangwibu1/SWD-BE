{
  "name": "architecture-evaluation-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluator API, experiment worker and e-commerce SUT roles for AI architecture evaluation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "cross-env APP_ROLE=controller-api tsx watch src/main.ts",
    "dev:worker": "cross-env APP_ROLE=experiment-worker tsx watch src/main.ts",
    "dev:monolith": "cross-env APP_ROLE=sut-monolith tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "cross-env APP_ROLE=controller-api node dist/main.js",
    "start:worker": "cross-env APP_ROLE=experiment-worker node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:evaluator:migrate": "tsx scripts/migrate-evaluator.ts",
    "db:sut:migrate": "tsx scripts/migrate-sut.ts",
    "db:sut:seed": "tsx scripts/seed-sut.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "candidate:validate": "tsx scripts/validate-candidate.ts",
    "experiment:smoke": "tsx scripts/run-smoke-experiment.ts",
    "report:rebuild": "tsx scripts/rebuild-report.ts",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "db:sut:reset": "tsx scripts/reset-sut.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "^2.2.0",
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "execa": "10.0.1",
    "express": "5.2.1",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "redis": "6.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
