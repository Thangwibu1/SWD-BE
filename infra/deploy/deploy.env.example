# Use immutable repo@sha256:... values for a publication campaign.
BACKEND_IMAGE=architecture-evaluation-backend:0.1.0
SUT_IMAGE=architecture-evaluation-backend:0.1.0
FRONTEND_IMAGE=architecture-evaluation-frontend:0.1.0

PUBLIC_ORIGIN=http://localhost:8088
PUBLIC_PORT=8088

# Dedicated Ubuntu load generator (used with load-host.compose.yaml).
LOAD_HOST_SSH=bench@10.0.0.20
LOAD_HOST_WORKDIR=/opt/architecture-benchmark
LOAD_HOST_SUT_HOST=10.0.0.10
LOAD_HOST_SSH_KEY_PATH=./secrets/load-host-ed25519
LOAD_HOST_KNOWN_HOSTS_PATH=./secrets/known_hosts
K6_TIMESERIES_MODE=auto
K6_FULL_TIMESERIES_MAX_RPS=500
K6_EXPECTED_ITERATION_SECONDS=0.30
K6_VU_HEADROOM=1.5
K6_MAX_VUS_MULTIPLIER=2
K6_MAX_VUS_CAP=20000
K6_E2E_POLL_SAMPLE_RATE=0.01
