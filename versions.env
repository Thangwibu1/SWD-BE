# Pinned versions for every image/tool used by the benchmark.
# Never use the `latest` tag. Main experiment must replace BACKEND_IMAGE_DIGEST
# with an immutable sha256 digest (see README "Image digest").
NODE_VERSION=22.19.0
NODE_IMAGE=node:22.19.0-alpine3.22
POSTGRES_VERSION=16.10-alpine3.22
REDIS_VERSION=7.4.6-alpine3.21
RABBITMQ_VERSION=3.13.7-management-alpine
NGINX_VERSION=1.28.0-alpine3.21
PROMETHEUS_VERSION=v2.55.1
CADVISOR_VERSION=v0.52.1
K6_VERSION=v1.3.0
BACKEND_IMAGE_DIGEST=architecture-evaluation-backend:0.1.0
