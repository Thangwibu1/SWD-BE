{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-evaluation.local/schemas/events/inventory-reserved.schema.json",
  "title": "inventory.reserved Event Payload",
  "description": "Emitted when inventory successfully reserves stock for an order",
  "type": "object",
  "required": ["orderId", "userId", "items", "amount", "paymentMode"],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": { "type": "string", "format": "uuid" },
    "amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "paymentMode": { "type": "string", "enum": ["MOCK_SUCCESS", "MOCK_FAIL", "MOCK_TIMEOUT"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
