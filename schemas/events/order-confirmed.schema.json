{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-evaluation.local/schemas/events/order-confirmed.schema.json",
  "title": "order.confirmed Event Payload",
  "description": "Emitted when order transitions to CONFIRMED state after successful payment",
  "type": "object",
  "required": ["orderId", "userId", "totalAmount", "items"],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "totalAmount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
        },
        "additionalProperties": false
      }
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
