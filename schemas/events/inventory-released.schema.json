{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-evaluation.local/schemas/events/inventory-released.schema.json",
  "title": "inventory.released Event Payload",
  "description": "Emitted when inventory releases reserved stock (compensation after payment failure or cancel)",
  "type": "object",
  "required": ["orderId", "releases"],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "enum": ["PAYMENT_FAILED", "ORDER_CANCELLED"]
    }
  },
  "additionalProperties": false
}
