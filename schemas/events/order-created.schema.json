{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-evaluation.local/schemas/events/order-created.schema.json",
  "title": "order.created Event Payload",
  "description": "Emitted when a new order is created in PENDING state",
  "type": "object",
  "required": ["orderId", "userId", "items", "totalAmount", "idempotencyKey", "paymentMode"],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "totalAmount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "idempotencyKey": {
      "type": "string",
      "maxLength": 80
    },
    "paymentMode": {
      "type": "string",
      "enum": ["MOCK_SUCCESS", "MOCK_FAIL", "MOCK_TIMEOUT"]
    }
  },
  "additionalProperties": false
}
