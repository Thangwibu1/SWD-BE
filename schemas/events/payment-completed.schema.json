{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-evaluation.local/schemas/events/payment-completed.schema.json",
  "title": "payment.completed Event Payload",
  "description": "Emitted when payment processing succeeds",
  "type": "object",
  "required": ["orderId", "userId", "amount", "transactionId", "items"],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": { "type": "string", "format": "uuid" },
    "amount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "transactionId": {
      "type": "string",
      "maxLength": 80
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
        },
        "additionalProperties": false
      }
    },
    "paymentMethod": {
      "type": "string",
      "enum": ["MOCK_SUCCESS", "MOCK_DELAYED"]
    }
  },
  "additionalProperties": false
}
