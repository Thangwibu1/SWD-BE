{
  "extends": "study.json",
  "studyId": "apikey-fan-6-models-6x-volume-v1",
  "scenarios": [
    {
      "id": "ecommerce-volume",
      "requirements": "Thiết kế backend e-commerce có đăng nhập, duyệt sản phẩm, giỏ hàng, checkout, xem và hủy đơn CONFIRMED. Hãy chọn đúng một kiến trúc trong catalog và giải thích đánh đổi về độ phức tạp vận hành, chi phí, tính nhất quán, khả năng chịu lỗi và mở rộng. Không giả định kiến trúc đạt SLO trước benchmark; cùng lựa chọn sẽ được đo độc lập ở 10.000, 100.000 và 500.000 business operations.",
      "workloadProfile": "MIXED_V1",
      "expected": "supported"
    }
  ],
